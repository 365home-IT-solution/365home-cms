{
    "name": "goldenbeeltd-vn/post-module",
    "name-module-vi": "Bài viết",
    "docs": "/tai-lieu-huong-dan/post/getting-started",
    "type": "laravel-module",
    "description": "Hệ thống bài viết là giải pháp toàn diện để quản lý nội dung. Cung cấp trải nghiệm người dùng thân thiện với các tính năng soạn thảo nội dung đa phương tiện, SEO tối ưu",
    "version": "1.0.0",
    "license": "proprietary",
    "authors": [
        {
            "name": "Golden Bee IT Solutions Co., Ltd",
            "email": "support@goldenbeeltd.vn",
            "homepage": "https://goldenbeeltd.vn",
            "role": "Developer"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Post\\": ""
        }
    },
    "require": {
        "php": "^7.4|^8.0",
        "laravel/framework": "^8.0|^9.0|^10.0",
        "codewithdennis/filament-select-tree": "^3.1",
        "filament/spatie-laravel-media-library-plugin": "^3.2",
        "filament/spatie-laravel-tags-plugin": "^3.2"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "laravel",
        "module",
        "post"
    ],
    "homepage": "https://github.com/goldenbeeltd-vn/post-module",
    "repository": {
        "type": "git",
        "url": "git@github.com:goldenbeeltd-vn/post-module.git"
    },
    "config": {
        "allow-plugins": {
            "joshbrw/laravel-module-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan module:enable Post"
        ]
    }
}