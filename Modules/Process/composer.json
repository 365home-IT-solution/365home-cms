{
    "name": "goldenbeeltd-vn/process-module",
    "name-module-vi": "Quy trình",
    "docs": "/tai-lieu-huong-dan/process/getting-started",
    "type": "laravel-module",
    "description": "Hệ thống tạo quy trình tuần tự, cho phép định nghĩa và kiểm soát từng bước trong chuỗi công việc.",
    "version": "1.0.0",
    "license": "proprietary",
    "authors": [
        {
            "name": "Golden Bee IT Solutions Co., Ltd",
            "email": "support@goldenbeeltd.vn",
            "homepage": "https://goldenbeeltd.vn",
            "role": "Developer"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Process\\": ""
        }
    },
    "require": {
        "php": "^7.4|^8.0",
        "laravel/framework": "^8.0|^9.0|^10.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "laravel",
        "module",
        "process"
    ],
    "homepage": "https://github.com/goldenbeeltd-vn/process-module",
    "repository": {
        "type": "git",
        "url": "git@github.com:goldenbeeltd-vn/process-module.git"
    },
    "config": {
        "allow-plugins": {
            "joshbrw/laravel-module-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan module:enable Process"
        ]
    }
}