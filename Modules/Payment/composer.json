{
    "name": "goldenbeeltd-vn/payment-module",
    "name-module-vi": "Thanh toán",
    "docs": "/tai-lieu-huong-dan/payment/getting-started",
    "type": "laravel-module",
    "description": "Hệ thống thanh toán và quản lí đơn hàng thủ công.",
    "version": "1.0.0",
    "license": "proprietary",
    "authors": [
        {
            "name": "Golden Bee IT Solutions Co., Ltd",
            "email": "support@goldenbeeltd.vn",
            "homepage": "https://goldenbeeltd.vn",
            "role": "Developer"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Payment\\": ""
        }
    },
    "require": {
        "php": "^7.4|^8.0",
        "laravel/framework": "^8.0|^9.0|^10.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "laravel",
        "module",
        "payment"
    ],
    "homepage": "https://github.com/goldenbeeltd-vn/payment-module",
    "repository": {
        "type": "git",
        "url": "git@github.com:goldenbeeltd-vn/payment-module.git"
    },
    "config": {
        "allow-plugins": {
            "joshbrw/laravel-module-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan module:enable Payment"
        ]
    }
}
