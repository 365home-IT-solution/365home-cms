{
    "name": "goldenbeeltd-vn/base-cms",
    "type": "project",
    "description": "Hệ thống chính",
    "upgradge": "Update mail configuration page and settings, Modify user model and profile page, Update breezy session table, Update Vietnamese translations",
    "version": "1.0.0",
    "license": "proprietary",
    "authors": [
        {
            "name": "Golden Bee IT Solutions Co., Ltd",
            "email": "support@goldenbeeltd.vn",
            "homepage": "https://goldenbeeltd.vn",
            "role": "Developer"
        }
    ],
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "base"
    ],
    "require": {
        "php": "^8.2",
        "awcodes/filament-table-repeater": "^3.1",
        "bacon/bacon-qr-code": "^3.0",
        "calebporzio/sushi": "^2.5",
        "codewithdennis/filament-select-tree": "^3.1",
        "coolsam/modules": "^3.0",
        "filament/filament": "^3.2",
        "filament/spatie-laravel-media-library-plugin": "^3.2",
        "filament/spatie-laravel-settings-plugin": "^3.2",
        "filament/spatie-laravel-tags-plugin": "^3.2",
        "flowframe/laravel-trend": "^0.3",

        "guava/calendar": "^1.14",
        "guzzlehttp/guzzle": "^7.2",
        "josespinal/filament-record-navigation": "^2.0",
        "juliomotol/filament-password-confirmation": "^1.2",
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.0",
        "laravel/tinker": "^2.8",
        "league/commonmark": "^2.4",
        "livewire/livewire": "^3.5",
        "maatwebsite/excel": "^3.1",
        "mhmiton/laravel-modules-livewire": "^2.3",
        "n0sz/commonmark-marker-extension": "^1.0",
        "nwidart/laravel-modules": "^10.0",
        "opcodesio/log-viewer": "^3.11",
        "payos/payos": "^1.0",
        "pragmarx/google2fa": "^7.0|^8.0",
        "predis/predis": "^3.0",
        "riodwanto/filament-ace-editor": "^1.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.9",
        "spatie/laravel-settings": "^3.4",
        "spatie/laravel-tags": "^4.0",
        "thiktak/filament-simple-list-entry": "^1.0",
        "wikimedia/composer-merge-plugin": "2.1",
        "z3d0x/filament-logger": "^0.7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "BezhanSalleh\\FilamentShield\\": "plugins/filament-shield/src/",
            "BezhanSalleh\\FilamentExceptions\\": "plugins/filament-exceptions/src/",
            "TomatoPHP\\ConsoleHelpers\\": "plugins/console-helpers/src/",
            "TomatoPHP\\FilamentIcons\\": "plugins/filament-icons/src/",
            "TomatoPHP\\FilamentMediaManager\\": "plugins/filament-media-manager/src/",
            "AmidEsfahani\\FilamentTinyEditor\\": "plugins/filament-tinyeditor/src/",
            "Jeffgreco13\\FilamentBreezy\\": "plugins/filament-breezy/src/",
            "Guava\\FilamentKnowledgeBase\\": "plugins/filament-knowledge-base/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": []
}
